# Docker Compose
COMPOSE_PROJECT_NAME=remote-sensing-agent

# PostgreSQL / pgvector
POSTGRES_DB=remote_sensing_agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Java business service
BUSINESS_SERVICE_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/remote_sensing_agent
SPRING_DATASOURCE_USERNAME=agent
SPRING_DATASOURCE_PASSWORD=change-me-for-local-development
DEMO_FAULTS_ENABLED=true
DEMO_FAULT_MAX_DELAY_MS=2000
DEMO_FAULT_TIMEOUT_DELAY_MS=5000

# Python Agent service
AGENT_SERVICE_PORT=8000
AGENT_LOG_LEVEL=INFO
BUSINESS_SERVICE_URL=http://business-service:8080
BUSINESS_CONNECT_TIMEOUT_SECONDS=2.0
BUSINESS_READ_TIMEOUT_SECONDS=3.0
BUSINESS_WRITE_TIMEOUT_SECONDS=3.0
BUSINESS_POOL_TIMEOUT_SECONDS=1.0
SESSION_TTL_SECONDS=1800
DATABASE_URL=postgresql://agent:change-me-for-local-development@postgres:5432/remote_sensing_agent

# Web console
WEB_CONSOLE_PORT=5173
VITE_AGENT_API_URL=http://localhost:8000
VITE_BUSINESS_API_URL=http://localhost:8080

# Diagnosis/router model provider (concrete adapter is not wired yet)
MODEL_PROVIDER=openai
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=

# M4.4 Embedding provider (required only when running embedding generation)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=2
EMBEDDING_INITIAL_BACKOFF_SECONDS=0.2
EMBEDDING_MAX_BACKOFF_SECONDS=2.0
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_INDEX_VERSION=text-embedding-3-small-1536-v1
